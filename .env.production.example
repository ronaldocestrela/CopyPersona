# ==========================================
# PersonaScript AI - Variáveis de Ambiente de Produção / Demonstração
# ==========================================

# 1. Configuração do ASP.NET Core e Portas no Host
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
APPLY_MIGRATIONS=true

# 2. Banco de Dados SQL Server
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=PersonaScript_ProdPass2026!Strong
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=PersonaScript;User Id=sa;Password=PersonaScript_ProdPass2026!Strong;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30;

# 3. Autenticação JWT e Social
Jwt__Secret=SuperSecretProductionKey_PersonaScript_2026_Min32CharsLong!
Jwt__Issuer=PersonaScript.Server
Jwt__Audience=PersonaScript.Client
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# 4. Configuração de Provedores de Inteligência Artificial (LLM)
# Options: Mock, OpenAI, GoogleGemini, Anthropic
LLM__PrimaryProvider=Mock
LLM__FallbackProviders=Mock

LLM__OpenAiApiKey=
LLM__OpenAiEndpoint=https://api.openai.com/v1/chat/completions
LLM__DefaultOpenAiModel=gpt-4o

LLM__GeminiApiKey=
LLM__DefaultGeminiModel=gemini-1.5-pro

LLM__AnthropicApiKey=
LLM__DefaultAnthropicModel=claude-3-5-sonnet-20241022

# 5. Faturamento e Assinaturas (Stripe)
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=
Stripe__MonthlyPriceId=
Stripe__AnnualPriceId=

# 6. E-mail Transacional (Resend e Mailpit Demo)
Resend__ApiKey=re_123456789
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# 7. Master Administrator (Backoffice Seed)
MASTER_ADMIN_EMAIL=admin@personascript.ai
MASTER_ADMIN_PASSWORD=AdminPersonaScript2026!
MASTER_ADMIN_NAME=Master Administrator
