@namespace PersonaScript.Server.Components.Anamnese.Steps
@using PersonaScript.Modules.Anamnese.Application.DTOs

<div class="anamnese-step-card">
    <h3 style="font-size: 1.5rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">
        Etapa 3 — Seu Trabalho
    </h3>
    <p style="color: #94a3b8; margin-bottom: 1.5rem;">
        Onde você brilha e como você entrega seus procedimentos ou atendimentos.
    </p>

    <!-- 3.1 -->
    <div class="anamnese-field-group">
        <label class="anamnese-label">3.1 Qual o seu procedimento ou serviço MÁSTER (seu maior destaque)?</label>
        <input type="text" class="anamnese-input" placeholder="Ex: Harmonização facial de alta precisão" 
               value="@Model.ProcedimentoMaster" @oninput="OnMasterChanged" />
    </div>

    <!-- 3.2 -->
    <div class="anamnese-field-group">
        <label class="anamnese-label">3.2 Qual o procedimento mais LUCRATIVO do seu consultório?</label>
        <input type="text" class="anamnese-input" placeholder="Ex: Protocolos de rejuvenescimento de 12 meses" 
               value="@Model.ProcedimentoLucrativo" @oninput="OnLucrativoChanged" />
    </div>

    <!-- 3.3 -->
    <div class="anamnese-field-group">
        <label class="anamnese-label">3.3 Qual procedimento você mais GOSTA de realizar?</label>
        <input type="text" class="anamnese-input" placeholder="Ex: Cirurgia de implantes complexos" 
               value="@Model.ProcedimentoPreferido" @oninput="OnPreferidoChanged" />
    </div>

    <!-- 3.4 -->
    <div class="anamnese-field-group">
        <label class="anamnese-label">3.4 Qual o grande diferencial do seu atendimento?</label>
        <textarea class="anamnese-textarea" rows="3" placeholder="Ex: Consulta sem pressa de 1h30, escuta ativa, café personalizado..."
                  value="@Model.DiferencialAtendimento" @oninput="OnDiferencialChanged"></textarea>
        <AnamneseCharacterCounter Text="@Model.DiferencialAtendimento" />
    </div>

    <!-- 3.5 -->
    <div class="anamnese-field-group">
        <label class="anamnese-label">3.5 Por que os pacientes escolhem você e não o concorrente?</label>
        <textarea class="anamnese-textarea" rows="3" placeholder="Ex: Pela naturalidade dos resultados e pela segurança da pós-consulta..."
                  value="@Model.PorQueEscolhemVoce" @oninput="OnPorQueEscolhemChanged"></textarea>
        <AnamneseCharacterCounter Text="@Model.PorQueEscolhemVoce" />
    </div>

    <!-- 3.6 -->
    <div class="anamnese-field-group">
        <label class="anamnese-label">3.6 Qual sua crítica respeitosa às práticas ultrapassadas ou ruins dos seus pares?</label>
        <textarea class="anamnese-textarea" rows="3" placeholder="Ex: Tratamento padronizado em massa sem olhar a individualidade..."
                  value="@Model.CriticaAosPares" @oninput="OnCriticaChanged"></textarea>
    </div>
</div>

@code {
    [Parameter] public Etapa3Dto Model { get; set; } = new("", "", "", "", "", "");
    [Parameter] public EventCallback<Etapa3Dto> ModelChanged { get; set; }

    private async Task OnMasterChanged(ChangeEventArgs e) => await Update(Model with { ProcedimentoMaster = e.Value?.ToString() ?? "" });
    private async Task OnLucrativoChanged(ChangeEventArgs e) => await Update(Model with { ProcedimentoLucrativo = e.Value?.ToString() ?? "" });
    private async Task OnPreferidoChanged(ChangeEventArgs e) => await Update(Model with { ProcedimentoPreferido = e.Value?.ToString() ?? "" });
    private async Task OnDiferencialChanged(ChangeEventArgs e) => await Update(Model with { DiferencialAtendimento = e.Value?.ToString() ?? "" });
    private async Task OnPorQueEscolhemChanged(ChangeEventArgs e) => await Update(Model with { PorQueEscolhemVoce = e.Value?.ToString() ?? "" });
    private async Task OnCriticaChanged(ChangeEventArgs e) => await Update(Model with { CriticaAosPares = e.Value?.ToString() ?? "" });

    private async Task Update(Etapa3Dto updated)
    {
        Model = updated;
        await ModelChanged.InvokeAsync(Model);
    }
}
