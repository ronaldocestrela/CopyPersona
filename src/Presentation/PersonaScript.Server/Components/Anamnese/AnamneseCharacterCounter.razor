@namespace PersonaScript.Server.Components.Anamnese
@using PersonaScript.Modules.Anamnese.Application.Services

<div class="d-flex align-items-center gap-2">
    <span class="anamnese-counter-badge @BadgeClass">
        @TextLength caracteres (@BadgeText)
    </span>
</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string[]? CustomCliches { get; set; }

    private int TextLength => Text?.Trim().Length ?? 0;

    private bool IsVague => HeuristicClarificationAnalyzer.IsVagueOrShort(
        Text,
        20,
        CustomCliches ?? HeuristicClarificationAnalyzer.GenericClichesEtapa3
    );

    private string BadgeClass => (TextLength, IsVague) switch
    {
        (0, _) => "short",
        (< 20, _) => "short",
        (_, true) => "short", // Exibe badge em amarelo/âmbar quando detectada vagueza/clichê
        _ => "good"
    };

    private string BadgeText => (TextLength, IsVague) switch
    {
        (0, _) => "Pendente",
        (< 20, _) => "Resposta muito curta",
        (_, true) => "Resposta genérica — pode aprofundar",
        _ => "Boa resposta"
    };
}
