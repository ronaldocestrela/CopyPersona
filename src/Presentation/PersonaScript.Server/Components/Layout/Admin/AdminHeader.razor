@using Microsoft.AspNetCore.Components.Authorization

<header class="h-16 bg-slate-900/80 backdrop-blur border-b border-slate-800 px-6 flex items-center justify-between sticky top-0 z-40">
    <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-400">Ambiente:</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                Desenvolvimento
            </span>
        </div>
    </div>

    <div class="flex items-center gap-4">
        <AuthorizeView>
            <Authorized>
                <div class="flex items-center gap-3 pr-4 border-r border-slate-800">
                    <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-300 font-bold text-xs">
                        @(context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "A")
                    </div>
                    <div class="flex flex-col text-right">
                        <span class="text-xs font-semibold text-white">@(context.User.Identity?.Name ?? "Administrador")</span>
                        <span class="text-[10px] text-purple-400 font-medium">
                            @(context.User.IsInRole("SystemAdmin") ? "SystemAdmin" : 
                              context.User.IsInRole("SupportAgent") ? "SupportAgent" : 
                              context.User.IsInRole("FinanceAdmin") ? "FinanceAdmin" : "Operador")
                        </span>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <span class="text-xs text-slate-400">Não autenticado</span>
            </NotAuthorized>
        </AuthorizeView>

        <a href="/" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
            <span class="material-symbols-outlined text-base">open_in_new</span>
            <span>Voltar ao App</span>
        </a>

        <a href="logout" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600/10 hover:bg-rose-600/20 text-rose-400 border border-rose-500/20 transition-colors">
            Sair
        </a>
    </div>
</header>
