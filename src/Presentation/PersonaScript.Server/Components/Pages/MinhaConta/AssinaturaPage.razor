@page "/minha-conta/assinatura"
@using Microsoft.AspNetCore.Components.Web
@using PersonaScript.Modules.Billing.Application.Commands.CreateCheckoutSession
@using PersonaScript.Modules.Billing.Application.Commands.CreateCustomerPortalSession
@using PersonaScript.Modules.Billing.Application.DTOs
@using PersonaScript.Modules.Billing.Application.Queries.GetBillingInvoices
@using PersonaScript.Modules.Billing.Application.Queries.GetSubscriptionDetails
@using PersonaScript.Modules.Billing.Domain
@inject GetSubscriptionDetailsQueryHandler SubDetailsHandler
@inject GetBillingInvoicesQueryHandler InvoicesHandler
@inject CreateCustomerPortalSessionCommandHandler PortalHandler
@inject CreateCheckoutSessionCommandHandler CheckoutHandler
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="assinatura-container">
    <div class="assinatura-header">
        <div class="header-title-group">
            <h1>Minha Assinatura & Consumo</h1>
            <p>Gerencie seu plano, acompanhe o consumo das suas quotas mensais e acesse faturas.</p>
        </div>
        @if (SubscriptionDetails != null && !string.IsNullOrWhiteSpace(SubscriptionDetails.StripeCustomerId))
        {
            <button class="btn btn-primary btn-portal" @onclick="OpenStripePortal" disabled="@IsProcessingPortal">
                @if (IsProcessingPortal)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Abrindo Portal...</span>
                }
                else
                {
                    <span class="material-symbols-outlined me-1">credit_card</span>
                    <span>Gerenciar Assinatura & Faturas</span>
                }
            </button>
        }
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Carregando dados da assinatura...</p>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <span class="material-symbols-outlined me-2">error</span>
            <span>@ErrorMessage</span>
        </div>
    }
    else if (SubscriptionDetails != null)
    {
        @if (SubscriptionDetails.CancelAtPeriodEnd)
        {
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <span class="material-symbols-outlined me-2 fs-4">warning</span>
                <div>
                    <strong>Sua assinatura será cancelada</strong> ao término do período vigente em 
                    <strong>@SubscriptionDetails.CurrentPeriodEnd.ToString("dd/MM/yyyy")</strong>. 
                    Você pode reativá-la a qualquer momento no portal do Stripe.
                </div>
            </div>
        }

        <div class="dashboard-grid">
            <!-- Card Plano Atual -->
            <div class="card current-plan-card">
                <div class="card-header-custom">
                    <div>
                        <span class="badge @GetStatusBadgeClass(SubscriptionDetails.Status)">
                            @GetStatusLabel(SubscriptionDetails.Status)
                        </span>
                        <h2 class="plan-name mt-2">@SubscriptionDetails.PlanName</h2>
                    </div>
                    <div class="plan-price">
                        <span class="currency">R$</span>
                        <span class="amount">@SubscriptionDetails.MonthlyPrice.ToString("N0")</span>
                        <span class="period">/mês</span>
                    </div>
                </div>

                <div class="card-body-custom">
                    <div class="detail-row">
                        <span class="detail-label">Ciclo Atual:</span>
                        <span class="detail-value">
                            @SubscriptionDetails.CurrentPeriodStart.ToString("dd/MM/yyyy") até @SubscriptionDetails.CurrentPeriodEnd.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Renovação Automática:</span>
                        <span class="detail-value">
                            @(SubscriptionDetails.CancelAtPeriodEnd ? "Desativada" : "Ativa")
                        </span>
                    </div>
                </div>

                <div class="card-footer-custom">
                    <button class="btn btn-outline-light w-100" @onclick="OpenStripePortal" disabled="@IsProcessingPortal">
                        <span class="material-symbols-outlined me-1">settings</span>
                        Alterar Cartão ou Cancelar
                    </button>
                </div>
            </div>

            <!-- Card Consumo de Quotas Mensais -->
            <div class="card quota-usage-card">
                <div class="card-header-custom">
                    <h2>Franquia Mensal & Limites</h2>
                    <span class="text-muted small">
                        Renova em @SubscriptionDetails.CurrentPeriodEnd.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <div class="card-body-custom">
                    <!-- Progress Bar 1: Roteiros -->
                    <div class="quota-item">
                        <div class="quota-label-group">
                            <span class="quota-name">
                                <span class="material-symbols-outlined me-1 fs-5 text-primary">movie</span>
                                Roteiros de Vídeo
                            </span>
                            <span class="quota-count">
                                <strong>@SubscriptionDetails.ScriptsGeneratedCount</strong> / @SubscriptionDetails.ScriptsLimit
                            </span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar @GetProgressBarClass(SubscriptionDetails.ScriptsGeneratedCount, SubscriptionDetails.ScriptsLimit)"
                                 style="width: @CalculatePercentage(SubscriptionDetails.ScriptsGeneratedCount, SubscriptionDetails.ScriptsLimit)%"></div>
                        </div>
                    </div>

                    <!-- Progress Bar 2: Personas -->
                    <div class="quota-item mt-3">
                        <div class="quota-label-group">
                            <span class="quota-name">
                                <span class="material-symbols-outlined me-1 fs-5 text-info">person_pin</span>
                                Personas Ativas
                            </span>
                            <span class="quota-count">
                                <strong>@SubscriptionDetails.ActivePersonasCount</strong> / @SubscriptionDetails.ActivePersonasLimit
                            </span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar @GetProgressBarClass(SubscriptionDetails.ActivePersonasCount, SubscriptionDetails.ActivePersonasLimit)"
                                 style="width: @CalculatePercentage(SubscriptionDetails.ActivePersonasCount, SubscriptionDetails.ActivePersonasLimit)%"></div>
                        </div>
                    </div>

                    <!-- Progress Bar 3: Diagnósticos & Análises -->
                    <div class="quota-item mt-3">
                        <div class="quota-label-group">
                            <span class="quota-name">
                                <span class="material-symbols-outlined me-1 fs-5 text-warning">analytics</span>
                                Diagnósticos & Análises IA
                            </span>
                            <span class="quota-count">
                                <strong>@SubscriptionDetails.AiAnalysesCount</strong> / @SubscriptionDetails.AiAnalysesLimit
                            </span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar @GetProgressBarClass(SubscriptionDetails.AiAnalysesCount, SubscriptionDetails.AiAnalysesLimit)"
                                 style="width: @CalculatePercentage(SubscriptionDetails.AiAnalysesCount, SubscriptionDetails.AiAnalysesLimit)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seção Comparativo & Upgrade de Planos -->
        <div class="plans-section mt-5">
            <h2 class="section-title">Planos & Upgrade Self-Service</h2>
            <p class="section-subtitle">Escolha o plano ideal para acelerar sua produção de conteúdo com IA.</p>

            <div class="plans-grid mt-4">
                @foreach (var plan in SubscriptionDetails.AvailablePlans)
                {
                    var isCurrent = plan.Id == SubscriptionDetails.PlanId;
                    <div class="plan-card @(isCurrent ? "current" : "")">
                        @if (isCurrent)
                        {
                            <span class="current-tag">Seu Plano Atual</span>
                        }
                        <h3 class="plan-card-name">@plan.Name</h3>
                        <p class="plan-card-desc">@plan.Description</p>

                        <div class="plan-card-price">
                            <span class="price-val">R$ @plan.MonthlyPrice.ToString("N0")</span>
                            <span class="price-period">/mês</span>
                        </div>

                        <ul class="plan-features">
                            <li><span class="material-symbols-outlined text-success">check</span> <strong>@plan.MaxScriptsPerMonth</strong> roteiros de vídeo/mês</li>
                            <li><span class="material-symbols-outlined text-success">check</span> <strong>@plan.MaxActivePersonas</strong> persona(s) ativa(s)</li>
                            <li><span class="material-symbols-outlined text-success">check</span> <strong>@plan.MaxAiAnalysesPerMonth</strong> análises de IA/mês</li>
                        </ul>

                        <div class="plan-card-action">
                            @if (isCurrent)
                            {
                                <button class="btn btn-outline-secondary w-100" disabled>Plano Ativo</button>
                            }
                            else
                            {
                                <button class="btn btn-primary w-100" @onclick="() => UpgradePlan(plan.PlanType)">
                                    @(plan.MonthlyPrice > SubscriptionDetails.MonthlyPrice ? "Fazer Upgrade" : "Mudar de Plano")
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Histórico de Faturas -->
        <div class="invoices-section mt-5">
            <h2 class="section-title">Histórico de Faturas</h2>
            <div class="table-responsive mt-3">
                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Valor</th>
                            <th>Status</th>
                            <th>Identificador</th>
                            <th class="text-end">Recibo / PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Invoices.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Nenhuma fatura registrada no período.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var invoice in Invoices)
                            {
                                <tr>
                                    <td>@invoice.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>R$ @invoice.AmountPaid.ToString("N2")</td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            @invoice.Status.ToUpper()
                                        </span>
                                    </td>
                                    <td class="text-muted small">@invoice.InvoiceId</td>
                                    <td class="text-end">
                                        @if (!string.IsNullOrWhiteSpace(invoice.InvoicePdfUrl))
                                        {
                                            <a href="@invoice.InvoicePdfUrl" target="_blank" class="btn btn-sm btn-outline-info">
                                                <span class="material-symbols-outlined fs-6 align-middle me-1">download</span>
                                                PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private SubscriptionDetailsDto? SubscriptionDetails;
    private List<InvoiceDto> Invoices = new();
    private bool IsLoading = true;
    private bool IsProcessingPortal = false;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        var subResult = await SubDetailsHandler.Handle(new GetSubscriptionDetailsQuery(), CancellationToken.None);
        if (subResult.IsSuccess)
        {
            SubscriptionDetails = subResult.Value;
        }
        else
        {
            ErrorMessage = subResult.Error.Message;
        }

        var invResult = await InvoicesHandler.Handle(new GetBillingInvoicesQuery(), CancellationToken.None);
        if (invResult.IsSuccess)
        {
            Invoices = invResult.Value;
        }

        IsLoading = false;
    }

    private async Task OpenStripePortal()
    {
        IsProcessingPortal = true;
        var portalResult = await PortalHandler.Handle(new CreateCustomerPortalSessionCommand(Navigation.Uri), CancellationToken.None);
        if (portalResult.IsSuccess)
        {
            Navigation.NavigateTo(portalResult.Value.PortalUrl, forceLoad: true);
        }
        else
        {
            ErrorMessage = portalResult.Error.Message;
        }
        IsProcessingPortal = false;
    }

    private async Task UpgradePlan(PlanType planType)
    {
        var command = new CreateCheckoutSessionCommand(planType, "user@example.com", Navigation.Uri, Navigation.Uri);
        var result = await CheckoutHandler.Handle(command, CancellationToken.None);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(result.Value.CheckoutUrl, forceLoad: true);
        }
        else
        {
            ErrorMessage = result.Error.Message;
        }
    }


    private string GetStatusBadgeClass(SubscriptionStatus status) => status switch
    {
        SubscriptionStatus.Active => "bg-success text-white",
        SubscriptionStatus.Trialing => "bg-primary text-white",
        SubscriptionStatus.PastDue => "bg-danger text-white",
        SubscriptionStatus.Canceled => "bg-secondary text-white",
        _ => "bg-dark text-white"
    };

    private string GetStatusLabel(SubscriptionStatus status) => status switch
    {
        SubscriptionStatus.Active => "Assinatura Ativa",
        SubscriptionStatus.Trialing => "Período de Testes (Trial)",
        SubscriptionStatus.PastDue => "Inadimplente / Pendente",
        SubscriptionStatus.Canceled => "Cancelada",
        _ => "Desconhecido"
    };

    private int CalculatePercentage(int used, int limit)
    {
        if (limit <= 0) return 0;
        var pct = (int)Math.Round((double)used / limit * 100);
        return Math.Min(pct, 100);
    }

    private string GetProgressBarClass(int used, int limit)
    {
        var pct = CalculatePercentage(used, limit);
        if (pct >= 90) return "bg-danger";
        if (pct >= 70) return "bg-warning";
        return "bg-success";
    }
}
