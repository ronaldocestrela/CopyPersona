@if (IsVisible)
{
    <div class="modal-backdrop fade show" @onclick="Close"></div>
    <div class="modal fade show" tabindex="-1" role="dialog" aria-modal="true" @onclick="Close">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title-group">
                        <div class="modal-title-icon">
                            <span class="material-symbols-outlined">auto_awesome</span>
                        </div>
                        <div>
                            <h5 class="modal-title font-weight-bold">Regerar Roteiro com IA</h5>
                            <p class="modal-subtitle">Ajuste fino de tom e retenção</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close" aria-label="Fechar">
                        <span class="material-symbols-outlined" style="font-size: 1.15rem;">close</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="modal-description">
                        Informe abaixo o que você deseja ajustar no tom, no gancho, na linguagem ou na CTA para recriar o roteiro.
                    </p>

                    <div class="mb-3">
                        <label class="modal-form-label">Feedback / Instruções para a IA:</label>
                        <textarea class="modal-textarea form-control" rows="4"
                                  placeholder="Ex: Deixe o gancho mais informal, use metáforas mais simples e coloque uma CTA focada em resposta por Direct."
                                  @bind="FeedbackNotes"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mb-0" role="alert" style="border-radius: 0.5rem;">
                            @ErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-modal-cancel" @onclick="Close" disabled="@IsSubmitting">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-modal-submit" @onclick="Confirm" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Regerando...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.35rem; font-size: 1.15rem;">auto_awesome</span>
                            <span>Regerar Roteiro</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Guid ScriptId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRegenerateRequested { get; set; }

    private string FeedbackNotes { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private bool IsSubmitting { get; set; }

    private async Task Confirm()
    {
        if (string.IsNullOrWhiteSpace(FeedbackNotes))
        {
            ErrorMessage = "Por favor, informe instruções ou o que precisa ser ajustado.";
            return;
        }

        ErrorMessage = string.Empty;
        IsSubmitting = true;
        try
        {
            await OnRegenerateRequested.InvokeAsync(FeedbackNotes);
            FeedbackNotes = string.Empty;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        FeedbackNotes = string.Empty;
        ErrorMessage = string.Empty;
        await OnClose.InvokeAsync();
    }
}
