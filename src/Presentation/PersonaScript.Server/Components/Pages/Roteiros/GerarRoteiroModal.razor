@using PersonaScript.BuildingBlocks.CQRS
@using PersonaScript.Modules.Scripts.Application.Commands.GenerateVideoScript
@inject ICommandHandler<GenerateVideoScriptCommand, Guid> GenerateCommandHandler

@if (IsVisible)
{
    <div class="modal-backdrop fade show" @onclick="Close"></div>
    <div class="modal fade show" tabindex="-1" role="dialog" aria-modal="true" @onclick="Close">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title-group">
                        <div class="modal-title-icon">
                            <span class="material-symbols-outlined">auto_awesome</span>
                        </div>
                        <div>
                            <h5 class="modal-title font-weight-bold">Gerar Novo Roteiro com IA</h5>
                            <p class="modal-subtitle">Agente Copywriter & Estrategista de Retenção</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close" disabled="@IsSubmitting" aria-label="Fechar">
                        <span class="material-symbols-outlined" style="font-size: 1.15rem;">close</span>
                    </button>
                </div>

                <div class="modal-body">
                    <p class="modal-description">
                        Preencha as diretrizes do vídeo para que o Agente de IA crie um roteiro personalizado com gancho de alta retenção, estrutura persuasiva e CTA estratégica.
                    </p>

                    <div class="form-grid">
                        <div class="form-group-col-12">
                            <label class="modal-form-label">
                                <span>Tema do Vídeo <span class="required-dot">*</span></span>
                            </label>
                            <input type="text" name="tema" class="modal-input form-control"
                                   placeholder="Ex: Como evitar ansiedade antes de reuniões importantes"
                                   @bind="Tema" />
                        </div>

                        <div class="form-group-col-6">
                            <label class="modal-form-label">
                                <span>Pilar de Conteúdo <span class="required-dot">*</span></span>
                            </label>
                            <select name="pilarConteudo" class="modal-select form-select" @bind="PilarConteudo">
                                <option value="Educação & Esclarecimento">Educação & Esclarecimento</option>
                                <option value="Engajamento & Conexão">Engajamento & Conexão</option>
                                <option value="Autoridade & Prova Social">Autoridade & Prova Social</option>
                                <option value="Conversão & Vendas">Conversão & Vendas</option>
                            </select>
                        </div>

                        <div class="form-group-col-6">
                            <label class="modal-form-label">
                                <span>Objetivo do Vídeo <span class="required-dot">*</span></span>
                            </label>
                            <input type="text" name="objetivo" class="modal-input form-control"
                                   placeholder="Ex: Gerar comentários e atrair novos seguidores"
                                   @bind="Objetivo" />
                        </div>

                        <div class="form-group-col-12">
                            <label class="modal-form-label">
                                <span>Tom de Voz Desejado</span>
                                <span class="optional-tag">OPCIONAL</span>
                            </label>
                            <input type="text" name="tomDesejado" class="modal-input form-control"
                                   placeholder="Ex: Empático, Didático e Assertivo"
                                   @bind="TomDesejado" />
                        </div>

                        <div class="form-group-col-12">
                            <label class="modal-form-label">
                                <span>Instruções Adicionais para a IA</span>
                                <span class="optional-tag">OPCIONAL</span>
                            </label>
                            <textarea name="instrucoes" class="modal-textarea form-control" rows="3"
                                      placeholder="Ex: Use um exemplo prático do cotidiano e inclua uma CTA pedindo para comentar 'SABER MAIS'."
                                      @bind="InstrucoesAdicionais"></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">
                            <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.35rem; font-size: 1.2rem;">error</span>
                            <span>@ErrorMessage</span>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-modal-cancel" @onclick="Close" disabled="@IsSubmitting">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-modal-submit" @onclick="GenerateScript" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Gerando Roteiro com IA...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.35rem; font-size: 1.15rem;">auto_awesome</span>
                            <span>Gerar Roteiro com IA</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnScriptGenerated { get; set; }

    private string Tema { get; set; } = string.Empty;
    private string PilarConteudo { get; set; } = "Educação & Esclarecimento";
    private string Objetivo { get; set; } = string.Empty;
    private string TomDesejado { get; set; } = string.Empty;
    private string InstrucoesAdicionais { get; set; } = string.Empty;

    private string ErrorMessage { get; set; } = string.Empty;
    private bool IsSubmitting { get; set; }

    private async Task GenerateScript()
    {
        if (string.IsNullOrWhiteSpace(Tema) || string.IsNullOrWhiteSpace(PilarConteudo) || string.IsNullOrWhiteSpace(Objetivo))
        {
            ErrorMessage = "Preencha todos os campos obrigatórios (Tema, Pilar de Conteúdo e Objetivo).";
            return;
        }

        ErrorMessage = string.Empty;
        IsSubmitting = true;

        try
        {
            var command = new GenerateVideoScriptCommand(
                Tema,
                PilarConteudo,
                Objetivo,
                string.IsNullOrWhiteSpace(TomDesejado) ? null : TomDesejado,
                string.IsNullOrWhiteSpace(InstrucoesAdicionais) ? null : InstrucoesAdicionais);

            var result = await GenerateCommandHandler.Handle(command, CancellationToken.None);

            if (result.IsSuccess)
            {
                var scriptId = result.Value;
                ResetForm();
                await OnScriptGenerated.InvokeAsync(scriptId);
            }
            else
            {
                ErrorMessage = result.Error.Message;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task Close()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        Tema = string.Empty;
        PilarConteudo = "Educação & Esclarecimento";
        Objetivo = string.Empty;
        TomDesejado = string.Empty;
        InstrucoesAdicionais = string.Empty;
        ErrorMessage = string.Empty;
    }
}
