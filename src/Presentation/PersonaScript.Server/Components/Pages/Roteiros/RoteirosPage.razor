@page "/roteiros"
@rendermode InteractiveServer
@using PersonaScript.BuildingBlocks.CQRS
@using PersonaScript.Modules.Anamnese.Application.DTOs
@using PersonaScript.Modules.Anamnese.Application.Queries.GetAnamneseStatus
@using PersonaScript.Modules.Anamnese.Domain
@using PersonaScript.Modules.Scripts.Application.DTOs
@using PersonaScript.Modules.Scripts.Application.Queries.ListVideoScripts
@using PersonaScript.Modules.Scripts.Domain
@inject IQueryHandler<ListVideoScriptsQuery, IReadOnlyList<VideoScriptDto>> ListVideoScriptsQueryHandler
@inject IQueryHandler<GetAnamneseStatusQuery, AnamneseStatusDto> GetAnamneseStatusQueryHandler
@inject NavigationManager Navigation

<div class="roteiros-container">
    <div class="roteiros-header">
        <div class="roteiros-title-group">
            <h1>Hub de Conteúdo & Roteiros</h1>
            <p>Gerencie seus roteiros de vídeo de alta retenção, plano de stories e calendário estratégico.</p>
        </div>
        <div>
            @if (HasCompletedAnamnese)
            {
                <button class="btn btn-primary" @onclick="OpenGenerateModal" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <span class="material-symbols-outlined">auto_awesome</span> Gerar Roteiro com IA
                </button>
            }
            else
            {
                <a href="/anamnese" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <span class="material-symbols-outlined">add</span> Novo Conteúdo
                </a>
            }
        </div>
    </div>

    <div class="roteiros-filters">
        <div class="search-box">
            <span class="material-symbols-outlined">search</span>
            <input type="text" placeholder="Buscar por tema, palavra-chave ou pilar..."
                   value="@SearchTerm" @oninput="OnSearchInput" />
        </div>

        <div class="filter-pills">
            <button class="filter-pill @(SelectedStatus == null ? "active" : "")" @onclick="() => FilterByStatus(null)">
                Todos
            </button>

            <button class="filter-pill @(SelectedStatus == VideoScriptStatus.Draft ? "active" : "")" @onclick="() => FilterByStatus(VideoScriptStatus.Draft)">
                Rascunhos
            </button>

            <button class="filter-pill @(SelectedStatus == VideoScriptStatus.Approved ? "active" : "")" @onclick="() => FilterByStatus(VideoScriptStatus.Approved)">
                Aprovados
            </button>

            <button class="filter-pill @(SelectedStatus == VideoScriptStatus.Recorded ? "active" : "")" @onclick="() => FilterByStatus(VideoScriptStatus.Recorded)">
                Gravados
            </button>

            <button class="filter-pill @(SelectedStatus == VideoScriptStatus.Published ? "active" : "")" @onclick="() => FilterByStatus(VideoScriptStatus.Published)">
                Publicados
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Buscando seus roteiros...</p>
        </div>
    }
    else if (ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <span class="material-symbols-outlined" style="vertical-align: middle;">error</span>
            @ErrorMessage
        </div>
    }
    else if (Scripts == null || Scripts.Count == 0)
    {
        @if (HasCompletedAnamnese)
        {
            <div class="text-center py-5" style="background: var(--ps-card-bg); border: 1px dashed var(--ps-border); border-radius: 1rem; padding: 3rem;">
                <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--ps-primary);">auto_awesome</span>
                <h4 class="mt-3" style="color: var(--ps-text);">Nenhum roteiro encontrado</h4>
                <p style="color: var(--ps-text-muted); max-width: 500px; margin: 0.5rem auto 1.5rem;">
                    Sua Anamnese está concluída! Clique abaixo para gerar seu primeiro roteiro de vídeo de alta retenção com Inteligência Artificial.
                </p>
                <button class="btn btn-primary" @onclick="OpenGenerateModal">
                    <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.25rem;">auto_awesome</span>
                    Gerar Roteiro com IA
                </button>
            </div>
        }
        else
        {
            <div class="text-center py-5" style="background: var(--ps-card-bg); border: 1px dashed var(--ps-border); border-radius: 1rem; padding: 3rem;">
                <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--ps-text-muted);">video_library</span>
                <h4 class="mt-3" style="color: var(--ps-text);">Nenhum roteiro encontrado</h4>
                <p style="color: var(--ps-text-muted); max-width: 500px; margin: 0.5rem auto 1.5rem;">
                    Você ainda não possui roteiros gerados ou nenhum roteiro atende ao filtro selecionado. Conclua sua Anamnese para gerar seus primeiros roteiros.
                </p>
                <a href="/anamnese" class="btn btn-primary">Começar Anamnese</a>
            </div>
        }
    }
    else
    {
        <div class="roteiros-grid">
            @foreach (var script in Scripts)
            {
                <div class="roteiro-card">
                    <div>
                        <div class="roteiro-card-header">
                            <h3 class="roteiro-card-title">@script.Tema</h3>
                            <span class="badge-status @GetStatusCssClass(script.Status)">@GetStatusDisplayName(script.Status)</span>
                        </div>

                        <span class="roteiro-pilar-tag">📌 @script.PilarConteudo</span>
                        <p class="roteiro-card-preview">@script.Gancho</p>
                    </div>

                    <div class="roteiro-card-actions">
                        <a href="/roteiros/@script.Id" class="btn btn-sm btn-primary flex-grow-1">
                            Ver Roteiro
                        </a>
                        <button class="btn btn-sm btn-outline-light" @onclick="() => OpenTeleprompterFor(script)" title="Teleprompter">
                            <span class="material-symbols-outlined" style="font-size: 1.1rem;">live_tv</span>
                        </button>
                        <button class="btn btn-sm btn-outline-light" @onclick="() => OpenExportFor(script)" title="Exportar">
                            <span class="material-symbols-outlined" style="font-size: 1.1rem;">file_download</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<TeleprompterModal Script="@SelectedScript" IsVisible="@ShowTeleprompter" OnClose="@(() => ShowTeleprompter = false)" />
<ExportModal Script="@SelectedScript" IsVisible="@ShowExport" OnClose="@(() => ShowExport = false)" />
<GerarRoteiroModal IsVisible="@ShowGenerateModal" OnClose="@(() => ShowGenerateModal = false)" OnScriptGenerated="HandleScriptGenerated" />

@code {
    private IReadOnlyList<VideoScriptDto>? Scripts { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private bool HasCompletedAnamnese { get; set; }

    private VideoScriptStatus? SelectedStatus { get; set; }
    private string SearchTerm { get; set; } = string.Empty;

    private VideoScriptDto? SelectedScript { get; set; }
    private bool ShowTeleprompter { get; set; }
    private bool ShowExport { get; set; }
    private bool ShowGenerateModal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CheckAnamneseStatusAsync();
        await LoadScriptsAsync();
    }

    private async Task CheckAnamneseStatusAsync()
    {
        try
        {
            var statusResult = await GetAnamneseStatusQueryHandler.Handle(new GetAnamneseStatusQuery(), CancellationToken.None);
            if (statusResult.IsSuccess && statusResult.Value != null)
            {
                HasCompletedAnamnese = statusResult.Value.Status == AnamneseStatus.Concluido;
            }
        }
        catch
        {
            HasCompletedAnamnese = false;
        }
    }

    private async Task LoadScriptsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        var query = new ListVideoScriptsQuery(SelectedStatus, SearchTerm, null);
        var result = await ListVideoScriptsQueryHandler.Handle(query, CancellationToken.None);

        if (result.IsSuccess)
        {
            Scripts = result.Value;
        }
        else
        {
            ErrorMessage = result.Error.Message;
        }

        IsLoading = false;
    }

    private async Task FilterByStatus(VideoScriptStatus? status)
    {
        SelectedStatus = status;
        await LoadScriptsAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadScriptsAsync();
    }

    private void OpenTeleprompterFor(VideoScriptDto script)
    {
        SelectedScript = script;
        ShowTeleprompter = true;
    }

    private void OpenExportFor(VideoScriptDto script)
    {
        SelectedScript = script;
        ShowExport = true;
    }

    private void OpenGenerateModal()
    {
        ShowGenerateModal = true;
    }

    private async Task HandleScriptGenerated(Guid scriptId)
    {
        ShowGenerateModal = false;
        await LoadScriptsAsync();
        Navigation.NavigateTo($"/roteiros/{scriptId}");
    }

    private static string GetStatusCssClass(VideoScriptStatus status) => status switch
    {
        VideoScriptStatus.Draft => "draft",
        VideoScriptStatus.Approved => "approved",
        VideoScriptStatus.Recorded => "recorded",
        VideoScriptStatus.Published => "published",
        _ => "draft"
    };

    private static string GetStatusDisplayName(VideoScriptStatus status) => status switch
    {
        VideoScriptStatus.Draft => "Rascunho",
        VideoScriptStatus.Approved => "Aprovado",
        VideoScriptStatus.Recorded => "Gravado",
        VideoScriptStatus.Published => "Publicado",
        _ => "Rascunho"
    };
}

