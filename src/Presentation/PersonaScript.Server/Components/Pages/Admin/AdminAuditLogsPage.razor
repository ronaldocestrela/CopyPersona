@page "/admin/auditoria"
@layout PersonaScript.Server.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization
@using PersonaScript.BuildingBlocks.CQRS
@using PersonaScript.Modules.Backoffice.Application.DTOs
@using PersonaScript.Modules.Backoffice.Application.Queries.GetAuditLogs
@inject IQueryHandler<GetAuditLogsQuery, IReadOnlyList<AuditLogDto>> GetAuditLogsHandler
@attribute [Authorize(Policy = "RequireBackofficeAccess")]

<PageTitle>Logs de Auditoria — Backoffice PersonaScript AI</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-800 pb-5">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-3">
                <span class="material-symbols-outlined text-slate-400">history</span>
                Logs de Auditoria
            </h1>
            <p class="text-slate-400 text-sm mt-1">Trilha imutável de ações administrativas, impersonações de suporte e concessões</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-slate-500/10 text-slate-400 border border-slate-500/20">
            Audit Trail
        </span>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
        @if (IsLoading)
        {
            <div class="p-12 text-center text-slate-400">
                <span class="material-symbols-outlined text-3xl animate-spin text-indigo-400">progress_activity</span>
                <p class="text-sm mt-2">Carregando eventos de auditoria...</p>
            </div>
        }
        else if (!AuditLogs.Any())
        {
            <div class="p-12 text-center text-slate-400 space-y-3">
                <span class="material-symbols-outlined text-4xl text-slate-600">receipt_long</span>
                <p class="text-base font-bold text-white">Nenhum registro de auditoria encetado</p>
                <p class="text-xs text-slate-500">As ações executadas no Backoffice gerarão registros automaticamente nesta tela.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-950/50 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="px-6 py-4">Data & Hora</th>
                            <th class="px-6 py-4">Ação Registrada</th>
                            <th class="px-6 py-4">Operador (Admin)</th>
                            <th class="px-6 py-4">Tenant Afetado</th>
                            <th class="px-6 py-4">Detalhes</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
                        @foreach (var log in AuditLogs)
                        {
                            <tr class="hover:bg-slate-800/30 transition">
                                <td class="px-6 py-4 text-slate-400">
                                    @log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold @GetActionBadgeClass(log.ActionType)">
                                        @log.ActionType
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-white">
                                    @log.AdminEmail
                                </td>
                                <td class="px-6 py-4 text-slate-300">
                                    @log.TargetUserEmail
                                </td>
                                <td class="px-6 py-4 text-slate-400 max-w-xs truncate" title="@log.DetailsJson">
                                    @log.DetailsJson
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<AuditLogDto> AuditLogs { get; set; } = new();
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        var result = await GetAuditLogsHandler.Handle(new GetAuditLogsQuery(100), CancellationToken.None);
        if (result.IsSuccess)
        {
            AuditLogs = result.Value.ToList();
        }
        IsLoading = false;
    }

    private string GetActionBadgeClass(string actionType) => actionType switch
    {
        "START_IMPERSONATION" => "bg-amber-500/10 text-amber-400 border border-amber-500/20",
        "STOP_IMPERSONATION" => "bg-slate-500/10 text-slate-400 border border-slate-500/20",
        "FREEZE_ACCOUNT" => "bg-rose-500/10 text-rose-400 border border-rose-500/20",
        "UNFREEZE_ACCOUNT" => "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
        "GRANT_EXTRA_CREDITS" => "bg-indigo-500/10 text-indigo-400 border border-indigo-500/20",
        "RESET_USER_PASSWORD" => "bg-purple-500/10 text-purple-400 border border-purple-500/20",
        _ => "bg-slate-800 text-slate-300"
    };
}
