@page "/admin"
@layout PersonaScript.Server.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "RequireBackofficeAccess")]

<PageTitle>Dashboard Operacional — Backoffice PersonaScript AI</PageTitle>

<div class="space-y-8">
    <!-- Top Header Title -->
    <div class="flex items-center justify-between border-b border-slate-800 pb-5">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-3">
                <span class="material-symbols-outlined text-purple-400">dashboard</span>
                Dashboard Operacional
            </h1>
            <p class="text-slate-400 text-sm mt-1">Visão geral de métricas, saúde do sistema e atalhos operacionais</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-2"></span>
                Sistemas 100% Operacionais
            </span>
        </div>
    </div>

    <!-- Stats Overview Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-2">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-xs font-semibold uppercase tracking-wider">Assinantes Ativos</span>
                <span class="material-symbols-outlined text-purple-400 text-lg">group</span>
            </div>
            <p class="text-3xl font-extrabold text-white">1,248</p>
            <p class="text-xs text-emerald-400 flex items-center gap-1 font-medium">+12% este mês</p>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-2">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-xs font-semibold uppercase tracking-wider">Suporte Pendente</span>
                <span class="material-symbols-outlined text-amber-400 text-lg">support_agent</span>
            </div>
            <p class="text-3xl font-extrabold text-amber-400">3 CHAMADOS</p>
            <p class="text-xs text-slate-400 font-medium">Tempo médio 14m</p>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-2">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-xs font-semibold uppercase tracking-wider">Execuções de IA</span>
                <span class="material-symbols-outlined text-indigo-400 text-lg">auto_awesome</span>
            </div>
            <p class="text-3xl font-extrabold text-indigo-400">8,920</p>
            <p class="text-xs text-indigo-300 font-medium">Latência média 1.8s</p>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-2">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-xs font-semibold uppercase tracking-wider">MRR Recorrente</span>
                <span class="material-symbols-outlined text-emerald-400 text-lg">payments</span>
            </div>
            <p class="text-3xl font-extrabold text-emerald-400">R$ 48.900</p>
            <p class="text-xs text-slate-400 font-medium">Churn rate 1.4%</p>
        </div>
    </div>

    <!-- Quick Access Modules Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Support & Operations Card -->
        <AuthorizeView Policy="RequireSupportAgent">
            <Authorized>
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                            Suporte ao Cliente & Tenants
                        </h2>
                        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                            Subfase 6.2
                        </span>
                    </div>
                    <p class="text-slate-400 text-sm">
                        Busca de assinantes, histórico de consumo de IA e ferramenta de Impersonation (Modo Suporte auditado).
                    </p>
                    <div class="pt-4 border-t border-slate-800 flex gap-3">
                        <a href="admin/tenants" class="px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-base">group</span>
                            <span>Gerenciar Tenants</span>
                        </a>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="bg-slate-900/50 border border-slate-800/50 rounded-2xl p-6 opacity-60">
                    <h2 class="text-lg font-bold text-slate-400">Suporte ao Cliente (Bloqueado)</h2>
                    <p class="text-slate-500 text-xs mt-1">Requer papel SupportAgent ou SystemAdmin.</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <!-- Prompt Engineering & System Admin Card -->
        <AuthorizeView Policy="RequireSystemAdmin">
            <Authorized>
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
                            Prompts de IA & Engenharia de Contexto
                        </h2>
                        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20">
                            Subfase 6.4
                        </span>
                    </div>
                    <p class="text-slate-400 text-sm">
                        Catálogo centralizado de prompts, versionamento dinâmico, playground de teste em tempo real e rollback.
                    </p>
                    <div class="pt-4 border-t border-slate-800 flex gap-3">
                        <a href="admin/prompts" class="px-4 py-2 text-xs font-semibold rounded-lg bg-purple-600 hover:bg-purple-500 text-white transition-colors flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-base">psychology</span>
                            <span>Catálogo de Prompts</span>
                        </a>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="bg-slate-900/50 border border-slate-800/50 rounded-2xl p-6 opacity-60">
                    <h2 class="text-lg font-bold text-slate-400">Gestão de Prompts (Bloqueado)</h2>
                    <p class="text-slate-500 text-xs mt-1">Requer papel SystemAdmin.</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
