@page "/admin/prompts"
@layout PersonaScript.Server.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "RequireSystemAdmin")]

<PageTitle>Prompts de IA & Engenharia — Backoffice PersonaScript AI</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-800 pb-5">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-3">
                <span class="material-symbols-outlined text-purple-400">psychology</span>
                Gestão Dinâmica de Prompts de IA
            </h1>
            <p class="text-slate-400 text-sm mt-1">Catálogo centralizado, versionamento, playground de testes e rollback instantâneo</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-400 border border-purple-500/20">
            Subfase 6.4 — Planejada
        </span>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center space-y-4">
        <div class="w-12 h-12 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto text-2xl">
            <span class="material-symbols-outlined">terminal</span>
        </div>
        <h3 class="text-lg font-bold text-white">Catálogo Dinâmico & Playground de Prompts</h3>
        <p class="text-slate-400 text-sm max-w-xl mx-auto">
            Esta seção abrigará a edição de `SystemPrompt` e `UserPromptTemplate` para os Agentes 1 e 2, permitindo testar em tempo real e publicar novas versões sem necessidade de re-deploy da aplicação.
        </p>
    </div>
</div>
