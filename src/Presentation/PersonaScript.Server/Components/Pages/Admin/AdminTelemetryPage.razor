@page "/admin/telemetria"
@layout PersonaScript.Server.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "RequireBackofficeAccess")]

<PageTitle>Telemetria & Custos de IA — Backoffice PersonaScript AI</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-800 pb-5">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-3">
                <span class="material-symbols-outlined text-indigo-400">monitoring</span>
                Telemetria & Observabilidade de IA
            </h1>
            <p class="text-slate-400 text-sm mt-1">Rastreamento de consumo de tokens, latência, custos de LLM e taxas de erro</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
            Subfase 6.5 — Planejada
        </span>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center space-y-4">
        <div class="w-12 h-12 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mx-auto text-2xl">
            <span class="material-symbols-outlined">insights</span>
        </div>
        <h3 class="text-lg font-bold text-white">Painel de Observabilidade & Custos de LLM</h3>
        <p class="text-slate-400 text-sm max-w-xl mx-auto">
            Exibirá gráficos de consumo diário/mensal de tokens, custos estimados em USD da API de LLM versus receita de assinaturas, tempo de resposta por agente e alertas de anomalia.
        </p>
    </div>
</div>
