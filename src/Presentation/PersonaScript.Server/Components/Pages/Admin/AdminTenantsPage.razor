@page "/admin/tenants"
@layout PersonaScript.Server.Components.Layout.Admin.AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "RequireSupportAgent")]

<PageTitle>Tenants & Usuários — Backoffice PersonaScript AI</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-800 pb-5">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-3">
                <span class="material-symbols-outlined text-indigo-400">group</span>
                Tenants & Usuários
            </h1>
            <p class="text-slate-400 text-sm mt-1">Gerenciamento de assinantes, diagnósticos e suporte ao cliente</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
            Subfase 6.2 — Planejada
        </span>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center space-y-4">
        <div class="w-12 h-12 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mx-auto text-2xl">
            <span class="material-symbols-outlined">person_search</span>
        </div>
        <h3 class="text-lg font-bold text-white">Módulo de Gestão de Tenants & Impersonation</h3>
        <p class="text-slate-400 text-sm max-w-xl mx-auto">
            Esta seção conterá a tabela de busca de assinantes com filtros por e-mail, plano e consumo, além da ferramenta de <strong>Modo Suporte (Impersonate Tenant)</strong> auditada.
        </p>
    </div>
</div>
