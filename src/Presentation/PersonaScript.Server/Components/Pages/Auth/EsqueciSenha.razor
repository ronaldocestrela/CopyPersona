@page "/esqueci-senha"
@layout AuthLayout

<PageTitle>Esqueci a senha — PersonaScript AI</PageTitle>

<AuthShell Title="Recuperar senha" Subtitle="Digite seu e-mail cadastrado para receber as instruções de redefinição.">
    <a class="auth-back-link" href="/login">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back_ios_new</span>
        Voltar ao login
    </a>

    @if (Success)
    {
        <div class="auth-success-alert" style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); color: #4ade80; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
            <p><strong>E-mail enviado!</strong> Se houver uma conta cadastrada com este e-mail, você receberá um link com instruções em breve.</p>
        </div>
    }

    <form method="post" action="/account/esqueci-senha" class="auth-form">
        <AntiforgeryToken />

        <AuthAlert Message="@Error" />

        <AuthTextField InputId="email"
                       Name="Email"
                       Label="Email"
                       Icon="mail"
                       InputType="email"
                       Placeholder="nome@exemplo.com"
                       Autocomplete="email"
                       Required="true" />

        <button type="submit" class="auth-primary-btn">
            Enviar instruções
            <span class="material-symbols-outlined" aria-hidden="true">send</span>
        </button>
    </form>
</AuthShell>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "success")]
    public bool Success { get; set; }
}
