@page "/cadastro"
@layout AuthLayout

<PageTitle>Cadastro — PersonaScript AI</PageTitle>

<AuthShell Title="Crie sua conta" Subtitle="Comece a gerar conteúdo inteligente em segundos.">
    <form method="post" action="/account/register" class="auth-form">
        <AntiforgeryToken />
        @if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        }

        <AuthAlert Message="@Error" />

        <AuthTextField InputId="fullName"
                       Name="FullName"
                       Label="Nome Completo"
                       Icon="person"
                       Placeholder="Como devemos te chamar?"
                       Autocomplete="name"
                       Required="true" />

        <AuthTextField InputId="email"
                       Name="Email"
                       Label="E-mail"
                       Icon="mail"
                       InputType="email"
                       Placeholder="seu@email.com"
                       Autocomplete="email"
                       Required="true" />

        <AuthTextField InputId="password"
                       Name="Password"
                       Label="Senha"
                       Icon="lock"
                       InputType="password"
                       Placeholder="Mínimo 8 caracteres"
                       Autocomplete="new-password"
                       ShowPasswordToggle="true"
                       Required="true"
                       MinLength="8" />

        <label class="auth-checkbox-row">
            <input type="checkbox" name="AcceptTerms" value="true" required />
            <span>
                Aceito os <a href="#">Termos de Uso</a> e <a href="#">Política de Privacidade</a>
            </span>
        </label>

        <button type="submit" class="auth-primary-btn">Criar Conta</button>
    </form>

    <AuthDivider Text="Ou continue com" />
    <AuthSocialButtons ReturnUrl="@ReturnUrl" />

    <p class="auth-footer-text">
        Já tem uma conta? <a class="auth-link" href="@GetLoginUrl()">Entre</a>
    </p>
</AuthShell>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string GetLoginUrl()
    {
        return string.IsNullOrWhiteSpace(ReturnUrl)
            ? "/login"
            : $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
    }
}
