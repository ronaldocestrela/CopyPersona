@page "/login"
@layout AuthLayout

<PageTitle>Login — PersonaScript AI</PageTitle>

<AuthShell Title="Bem-vindo de volta" Subtitle="Sua inteligência criativa te espera.">
    <form method="post" action="/account/login" class="auth-form">
        <AntiforgeryToken />

        <AuthAlert Message="@Error" />

        <AuthTextField InputId="email"
                       Name="Email"
                       Label="Email"
                       Icon="mail"
                       InputType="email"
                       Placeholder="nome@exemplo.com"
                       Autocomplete="email"
                       Required="true" />

        <AuthTextField InputId="password"
                       Name="Password"
                       Label="Senha"
                       Icon="lock"
                       InputType="password"
                       Placeholder="••••••••"
                       Autocomplete="current-password"
                       ShowPasswordToggle="true"
                       ShowLabelRow="true"
                       Required="true">
            <LabelAction>
                <a class="auth-link" href="/esqueci-senha">Esqueceu a senha?</a>
            </LabelAction>
        </AuthTextField>

        <button type="submit" class="auth-primary-btn">
            Entrar
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </button>
    </form>

    <AuthDivider Text="Ou entre com" />
    <AuthSocialButtons />

    <p class="auth-footer-text">
        Não tem uma conta? <a class="auth-link" href="/cadastro">Cadastre-se</a>
    </p>
</AuthShell>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
