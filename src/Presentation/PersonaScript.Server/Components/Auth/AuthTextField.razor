<div class="auth-field">
    @if (ShowLabelRow)
    {
        <div class="auth-field-row">
            <label for="@InputId">@Label</label>
            @LabelAction
        </div>
    }
    else
    {
        <label for="@InputId">@Label</label>
    }
    <div class="auth-input-wrap">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="auth-input-icon material-symbols-outlined" aria-hidden="true">@Icon</span>
        }
        <input id="@InputId"
               name="@Name"
               type="@InputType"
               placeholder="@Placeholder"
               autocomplete="@Autocomplete"
               required="@(Required ? "required" : null)"
               minlength="@(MinLength?.ToString())" />
        @if (ShowPasswordToggle)
        {
            <button type="button"
                    class="auth-toggle material-symbols-outlined"
                    data-password-toggle="@InputId"
                    aria-label="Mostrar senha">
                visibility
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string InputId { get; set; } = Guid.NewGuid().ToString("N");

    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Icon { get; set; }

    [Parameter] public string Placeholder { get; set; } = string.Empty;

    [Parameter] public string InputType { get; set; } = "text";

    [Parameter] public string Autocomplete { get; set; } = "off";

    [Parameter] public bool ShowPasswordToggle { get; set; }

    [Parameter] public bool ShowLabelRow { get; set; }

    [Parameter] public RenderFragment? LabelAction { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public int? MinLength { get; set; }
}
