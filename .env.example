# ==========================================
# PersonaScript AI - Variáveis de Ambiente (.env)
# ==========================================

# Database / SQL Server
MSSQL_SA_PASSWORD=PersonaScript_Dev123!
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=PersonaScript;User Id=sa;Password=PersonaScript_Dev123!;TrustServerCertificate=True

# Configuração de Provedores de Inteligência Artificial (LLM)
# PrimaryProvider: OpenAI, GoogleGemini, Anthropic, Mock
LLM__PrimaryProvider=Mock
LLM__FallbackProviders=Mock

# Chaves de API para uso de IA
LLM__OpenAiApiKey=
LLM__OpenAiEndpoint=https://api.openai.com/v1/chat/completions
LLM__DefaultOpenAiModel=gpt-4o

LLM__GeminiApiKey=
LLM__DefaultGeminiModel=gemini-1.5-pro

LLM__AnthropicApiKey=
LLM__DefaultAnthropicModel=claude-3-5-sonnet-20241022

# Autenticação JWT
Jwt__Secret=SuperSecretKey_PersonaScript_2026_Min32CharsLong!
Jwt__Issuer=PersonaScript.Server
Jwt__Audience=PersonaScript.Client

# E-mail (Resend)
Resend__ApiKey=re_123456789
